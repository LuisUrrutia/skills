{
  "schemaVersion": 1,
  "date": "2026-10-06",
  "package": "wayfinder",
  "scope": "SSH-pinned tree screening of all 19 previously supplied repositories, followed by selected full-file reading and explicitly identified partial screens. Not an exhaustive semantic audit of every file or linked workflow.",
  "previousLocalCommit": "5cc661092ff55f4ab4217fda8c6536c37005ace2",
  "objective": "Turn an ambiguous initiative into an evidence-backed direction that allows execution planning, preserving decisions and context across sessions.",
  "decision": "Rewrite the flow around the destination, an early durable map, real options, decisive evidence, and planning readiness. Preserve continuity and authority protections; do not append donor checklists.",
  "composition": [
    {
      "sourceId": "matt-wayfinder",
      "borrowed": [
        "Start with a destination and maintain a canonical map of decisions across sessions.",
        "Distinguish explicit decision questions, unresolved vague areas, and exclusions.",
        "Resolve questions through evidence, prototypes, and human judgment, then update dependent decisions.",
        "Separate authoritative decision details from the map's compact index."
      ],
      "localChoices": [
        "Use the user-approved objective: reach a defensible direction before execution planning.",
        "Allow local Markdown and existing records; make issue trackers, labels, branches, assignments, and delegation conditional.",
        "Keep the skill discoverable and omit the donor's disable-model-invocation control.",
        "Remove fixed token budgets, one-ticket-per-session limits, and mandatory specialist or agent setup.",
        "Compose local prototype and design-code-structure owners without inheriting donor implementation or approval gates.",
        "Revalidate changed premises, preserve superseded rationale, honor delegated judgment, and keep recommendations distinct from authorized scope changes.",
        "Continue already authorized planning without requiring a planning package or an extra approval.",
        "Keep short maps in one file, split larger records when useful, and account for storage lifetime and next-session access."
      ]
    },
    {
      "sourceId": "compound-wayfinder",
      "borrowed": [
        "Test the problem behind a proposed solution using current behavior, workarounds, and evidence of need.",
        "Compare real alternatives, including the incumbent or no change when credible, without padding a menu.",
        "Explain unfamiliar decision territory before asking the user to judge it.",
        "Scale investigation to reversibility and seek evidence that could disconfirm the direction."
      ],
      "localChoices": [
        "Use one portable decision map rather than CE configuration, artifact contracts, model tiers, or a prescribed folder.",
        "Honor settled choices and existing delegated authority without mandatory challenge, confirmation, or teaching-offer gates.",
        "Keep product, architecture, and migration decisions in scope; leave execution decomposition to planning.",
        "Use decision-relevant evidence rather than fixed research floors or forced numbers of options, sources, or questions."
      ]
    },
    {
      "sourceId": "blode-decision-briefs",
      "borrowed": [
        "Make option costs concrete, distinguish measured evidence from estimates, and ask about the fact on which the recommendation turns.",
        "Record what would change a decision and revisit its validity when a premise changes.",
        "Test consequential claims through the smallest relevant evidence surface, preserving inconclusive results."
      ],
      "localChoices": [
        "Adapt the decision mechanism before execution planning; do not import ticket splitting, implementation plans, or plan-review scorecards.",
        "Use previews only where they clarify a decision; no fixed word budget or mandatory numerical cost estimate.",
        "Keep durable context in the existing authoritative map rather than automatically creating another plan or proposing agent-memory writes."
      ]
    },
    {
      "sourceId": "pstack-wayfinder",
      "borrowed": [
        "Scale rigor to the impact and reversibility of a decision.",
        "Compare structurally distinct options when the choice is genuinely open.",
        "State a falsifiable observation, run a small experiment, and judge the actual artifact rather than a completion report."
      ],
      "localChoices": [
        "Keep discovery as the scope; do not import the full poteto-mode execution, delivery, audit-log, or review pipeline.",
        "Prototype only when it resolves a decision and is authorized, with no fixed count of implementations.",
        "Keep the existing decision map as the audit trail, and preserve task-specific permissions for delegation and external writes."
      ]
    }
  ],
