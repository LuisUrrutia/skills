#!/usr/bin/env python3
"""Rewrite English or Chinese prose with the humanizer model.

Reads a file argument or stdin, writes the rewrite to stdout, and reports
fact-check warnings on stderr. Runs the model with a local llama-server when
this machine has the memory for it, and otherwise calls the Runpod endpoint,
which needs RUNPOD_API_KEY and HUMANIZER_URL, the endpoint's /completion URL,
from the environment or as fish universal variables.
"""
import argparse
import hashlib
import json
import os
import platform
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from collections import Counter
from contextlib import ExitStack
from dataclasses import dataclass
from pathlib import Path

INSTR = (
    "Rewrite the text below so it reads like a person wrote it, not a language model.\n\n"
    "Reorganize it as you see fit. Vary sentence length on purpose. Cut hedging,\n"
    "throat-clearing, and any sentence that only announces what comes next.\n"
    "Prefer the concrete word over the abstract one. It is fine to sound uneven.\n\n"
    "Every fact, number, unit, date, name and quotation must survive unchanged."
)
SEP = "\n\n### Rewritten:\n\n"
# The model's context is 8192 tokens; chunks this size leave room for the rewrite.
MAX_CHUNK_CHARS = 3000
# A cold worker needs about 2 minutes to load the model; Runpod answers with an
# error while no worker is ready.
COLD_START_DEADLINE_S = 420

MODEL_REPO = "jialinyyzz/humanizer-GGUF"
# (file, minimum unified memory on Apple silicon, minimum VRAM on CUDA), in GiB,
# best first. The model card lists peak memory of 13.7 GB for Q8_0 and about
# 11 GB for Q6_K; smaller quantizations slip on facts more often, so a machine
# below these limits uses Runpod instead.
LOCAL_QUANTS = (
    ("humanizer-12b-Q8_0.gguf", 32, 16),
    ("humanizer-12b-Q6_K.gguf", 16, 12),
)
LOCAL_LOAD_DEADLINE_S = 300


def build_prompt(draft: str) -> str:
    return INSTR + "\n\n" + draft.strip() + SEP


assert hashlib.sha256(build_prompt("X").encode()).hexdigest()[:16] == "cc51d66b4c593fbe"


FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
HEADING = re.compile(r"^ {0,3}#{1,6}(\s|$)")


def bounded(text: str, limit: int = MAX_CHUNK_CHARS) -> list[str]:
    """Split text longer than limit at sentence, then word, then character bounds."""
    if len(text) <= limit:
        return [text]
    for separator in (r"(?<=[.!?。！？])\s+", r"\s+"):
        units = re.split(separator, text)
        if len(units) > 1:
            pieces, piece = [], ""
            for unit in units:
                if piece and len(piece) + len(unit) + 1 > limit:
                    pieces.append(piece)
                    piece = ""
                piece = f"{piece} {unit}" if piece else unit
            pieces.append(piece)
            return [part for piece in pieces for part in bounded(piece, limit)]
    return [text[i : i + limit] for i in range(0, len(text), limit)]


def split_blocks(text: str) -> list[tuple[bool, str]]:
    """Return (rewrite?, block) pairs; code fences and headings stay verbatim."""
    blocks: list[tuple[bool, str]] = []
    paragraphs: list[str] = []
    lines: list[str] = []

    def end_paragraph() -> None:
        if "".join(lines).strip():
            paragraphs.append("\n".join(lines).strip())
        lines.clear()

    def flush_prose() -> None:
        end_paragraph()
        chunk = ""
        for para in (piece for para in paragraphs for piece in bounded(para)):
            if chunk and len(chunk) + len(para) + 2 > MAX_CHUNK_CHARS:
                blocks.append((True, chunk))
                chunk = ""
            chunk = f"{chunk}\n\n{para}" if chunk else para
        if chunk:
            blocks.append((True, chunk))
        paragraphs.clear()

    source = text.splitlines()
    i = 0
    while i < len(source):
        line = source[i]
        opener = FENCE.match(line)
        if opener:
            flush_prose()
            marker = opener.group(1)
            # A fence closes only on a line of the same character, at least as long.
            closer = re.compile(rf"^ {{0,3}}{re.escape(marker[0])}{{{len(marker)},}}\s*$")
            j = i + 1
            while j < len(source) and not closer.match(source[j]):
                j += 1
            blocks.append((False, "\n".join(source[i : j + 1])))
            i = j + 1
            continue
        if HEADING.match(line):
            flush_prose()
            blocks.append((False, line.strip()))
        elif line.strip():
            lines.append(line)
        else:
            end_paragraph()
        i += 1
    flush_prose()
    return blocks


@dataclass
class Backend:
    url: str
    headers: dict[str, str]
    # How long a failing call keeps retrying; only a scaled-to-zero Runpod
    # endpoint needs to wait.
    retry_s: int


def call_model(draft: str, backend: Backend, n_predict: int) -> tuple[str, bool]:
    """Return the rewrite and whether it stopped at the n_predict limit."""
    body = {
        "prompt": build_prompt(draft),
        "temperature": 1.0,
        "top_p": 0.95,
        "top_k": 0,
        "min_p": 0,
        "repeat_penalty": 1.0,
        "n_predict": n_predict,
    }
    data = json.dumps(body).encode()
    headers = {"Content-Type": "application/json", **backend.headers}
    deadline = time.monotonic() + backend.retry_s
    while True:
        req = urllib.request.Request(backend.url, data, headers)
        try:
            with urllib.request.urlopen(req, timeout=330) as resp:
                try:
                    result = json.load(resp)
                except ValueError:
                    result = None
            content = result.get("content") if isinstance(result, dict) else None
            if not isinstance(content, str):
                sys.exit("humanize: the endpoint returned no text content")
            return content.strip(), result.get("stop_type") == "limit"
        except urllib.error.HTTPError as err:
            if err.code in (401, 403):
                sys.exit(f"humanize: Runpod rejected the API key (HTTP {err.code})")
            problem = f"HTTP {err.code}"
        except (urllib.error.URLError, TimeoutError) as err:
            problem = str(err)
        if time.monotonic() > deadline:
            sys.exit(f"humanize: model server not ready after {backend.retry_s}s ({problem})")
        print(f"humanize: waiting for a worker ({problem})", file=sys.stderr)
        time.sleep(10)


def fact_issues(draft: str, out: str) -> list[str]:
    issues = []
    for label, pattern in (("number", r"\d+(?:[.,]\d+)*"), ("url", r"https?://\S+")):
        before, after = Counter(re.findall(pattern, draft)), Counter(re.findall(pattern, out))
        issues += [f"missing {label} {x}" for x in sorted((before - after).elements())]
        issues += [f"added {label} {x}" for x in sorted((after - before).elements())]
    return issues


def rewrite_piece(draft: str, backend: Backend, n_predict: int) -> tuple[str, list[str]]:
    out, truncated = call_model(draft, backend, n_predict)
    issues = fact_issues(draft, out)
    if truncated:
        issues.insert(0, "rewrite cut off at the output limit")
    return out, issues


def probe(args: list[str], timeout: int) -> str:
    """Return the command's stdout, or "" when it fails, hangs or is missing."""
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


def fish(command: str) -> str:
    # Agents started from a GUI app run bash or zsh, which miss fish's PATH and
    # universal variables (`set -Ux`), the place settings persist across reboots.
    return probe(["fish", "-c", command], 10)


def setting(name: str) -> str:
    value = os.environ.get(name) or fish(f"printf %s ${name}")
    if not value:
        sys.exit(f"humanize: {name} is not set")
    return value


def runpod_backend() -> Backend:
    key = setting("RUNPOD_API_KEY")
    url = setting("HUMANIZER_URL")
    print("humanize: using the Runpod endpoint (billed)", file=sys.stderr)
    return Backend(url, {"Authorization": f"Bearer {key}"}, COLD_START_DEADLINE_S)


def memory_gib() -> tuple[float, float]:
    """Return (unified memory on Apple silicon, largest CUDA GPU's VRAM), in GiB."""
    unified = 0.0
    if sys.platform == "darwin" and platform.machine() == "arm64":
        memsize = probe(["sysctl", "-n", "hw.memsize"], 5)
        unified = int(memsize) / 2**30 if memsize.isdigit() else 0.0
    # nvidia-smi prints N/A for a GPU that does not report its memory.
    mibs = probe(["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"], 5)
    vram = max((int(mib) / 1024 for mib in mibs.split() if mib.isdigit()), default=0.0)
    return unified, vram


def local_quant() -> str | None:
    unified, vram = memory_gib()
    for name, min_unified, min_vram in LOCAL_QUANTS:
        if unified >= min_unified or vram >= min_vram:
            return name
    return None


def model_path(name: str) -> Path:
    """Return the cached GGUF, downloading it once from Hugging Face."""
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "humanize"
    path = cache / name
    if path.exists():
        return path
    cache.mkdir(parents=True, exist_ok=True)
    part = path.with_name(name + ".part")
    url = f"https://huggingface.co/{MODEL_REPO}/resolve/main/{name}"
    done = part.stat().st_size if part.exists() else 0
    # Downloads stop on flaky networks; resume where the last run left off.
    req = urllib.request.Request(url, headers={"Range": f"bytes={done}-"} if done else {})
    try:
        resp = urllib.request.urlopen(req, timeout=60)
    except urllib.error.HTTPError as err:
        # 416: the previous run downloaded every byte but stopped before the rename.
        if not (done and err.code == 416):
            raise
        resp = None
    total = 0
    if not resp:
        # Hugging Face's 416 carries no size; compare against the remote file's.
        with urllib.request.urlopen(urllib.request.Request(url, method="HEAD"), timeout=60) as head:
            total = int(head.headers.get("Content-Length", 0))
    if resp:
        print(f"humanize: downloading {name} once into {cache}", file=sys.stderr)
        with resp, open(part, "ab" if done else "wb") as out:
            if done and resp.status != 206:
                out.truncate(0)
                done = 0
            total = done + int(resp.headers.get("Content-Length", 0))
            reported = 0
            while chunk := resp.read(1 << 20):
                out.write(chunk)
                done += len(chunk)
                if total and done * 10 // total > reported:
                    reported = done * 10 // total
                    print(f"humanize: downloaded {reported * 10}%", file=sys.stderr)
    with open(part, "rb") as f:
        if f.read(4) != b"GGUF" or (total and part.stat().st_size != total):
            part.unlink()
            raise OSError(f"incomplete download of {name}")
    part.rename(path)
    return path


def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def start_local_server(llama_server: str, model: Path, log) -> tuple[subprocess.Popen, Backend]:
    port = free_port()
    server = subprocess.Popen(
        [llama_server, "-m", str(model), "-c", "8192", "-np", "1", "-ngl", "99",
         "--no-mmproj", "--host", "127.0.0.1", "--port", str(port)],
        stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
    )
    base = f"http://127.0.0.1:{port}"
    deadline = time.monotonic() + LOCAL_LOAD_DEADLINE_S
    while server.poll() is None and time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(f"{base}/health", timeout=5) as resp:
                if resp.status == 200:
                    return server, Backend(f"{base}/completion", {}, 0)
        except (urllib.error.URLError, TimeoutError, ConnectionError):
            pass
        time.sleep(1)
    server.kill()
    server.wait()
    log.seek(0)
    tail = log.read().decode(errors="replace").strip().splitlines()[-3:]
    raise OSError("llama-server did not start: " + " | ".join(tail))


def choose_backend(mode: str, stack) -> Backend:
    if mode == "runpod":
        return runpod_backend()
    quant = local_quant()
    llama_server = shutil.which("llama-server") or fish("command -s llama-server")
    problem = None
    if not quant:
        problem = "this machine has too little memory to run the model"
    elif not llama_server:
        problem = "llama-server is not installed (brew install llama.cpp)"
    else:
        try:
            model = model_path(quant)
            log = stack.enter_context(tempfile.TemporaryFile())
            server, backend = start_local_server(llama_server, model, log)
            stack.callback(server.wait)
            stack.callback(server.terminate)
            print(f"humanize: running {quant} locally", file=sys.stderr)
            return backend
        except OSError as err:
            problem = str(err)
    if mode == "local":
        sys.exit(f"humanize: cannot run locally: {problem}")
    print(f"humanize: {problem}; falling back to Runpod", file=sys.stderr)
    return runpod_backend()


def rewrite_text(text: str, backend: Backend) -> tuple[list[str], bool]:
    out_blocks = []
    flagged = False
    for rewrite, block in split_blocks(text):
        if not rewrite:
            out_blocks.append(block)
            continue
        out, issues = rewrite_piece(block, backend, max(256, min(2048, int(len(block) / 4 * 2.5))))
        if issues:
            # The model slips on single facts now and then; one more sample usually
            # fixes it. A cut-off rewrite gets the full output budget.
            retry, retry_issues = rewrite_piece(block, backend, 2048)
            if len(retry_issues) < len(issues):
                out, issues = retry, retry_issues
        if issues:
            flagged = True
            print(f"humanize: check this piece: {'; '.join(issues)}", file=sys.stderr)
        out_blocks.append(out)
    return out_blocks, flagged


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("file", nargs="?", help="input file (default: stdin)")
    parser.add_argument(
        "--backend", choices=("auto", "local", "runpod"), default="auto",
        help="auto runs locally when the machine can, else on Runpod (default: auto)",
    )
    args = parser.parse_args()

    text = open(args.file, encoding="utf-8").read() if args.file else sys.stdin.read()
    if not text.strip():
        sys.exit("humanize: empty input")

    with ExitStack() as stack:
        backend = choose_backend(args.backend, stack)
        out_blocks, flagged = rewrite_text(text, backend)
    print("\n\n".join(out_blocks))
    sys.exit(2 if flagged else 0)


if __name__ == "__main__":
    main()
