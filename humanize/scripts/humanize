#!/usr/bin/env python3
"""Rewrite English or Chinese prose with the humanizer model on Runpod.

Reads a file argument or stdin, writes the rewrite to stdout, and reports
fact-check warnings on stderr. Needs RUNPOD_API_KEY and HUMANIZER_URL, the
endpoint's /completion URL.
"""
import argparse
import hashlib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request
from collections import Counter

INSTR = (
    "Rewrite the text below so it reads like a person wrote it, not a language model.\n\n"
    "Reorganize it as you see fit. Vary sentence length on purpose. Cut hedging,\n"
    "throat-clearing, and any sentence that only announces what comes next.\n"
    "Prefer the concrete word over the abstract one. It is fine to sound uneven.\n\n"
    "Every fact, number, unit, date, name and quotation must survive unchanged."
)
SEP = "\n\n### Rewritten:\n\n"
# The model's context is 8192 tokens; chunks this size leave room for the rewrite.
MAX_CHUNK_CHARS = 3000
# A cold worker needs about 2 minutes to load the model; Runpod answers with an
# error while no worker is ready.
COLD_START_DEADLINE_S = 420


def build_prompt(draft: str) -> str:
    return INSTR + "\n\n" + draft.strip() + SEP


assert hashlib.sha256(build_prompt("X").encode()).hexdigest()[:16] == "cc51d66b4c593fbe"


FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
HEADING = re.compile(r"^ {0,3}#{1,6}(\s|$)")


def split_blocks(text: str) -> list[tuple[bool, str]]:
    """Return (rewrite?, block) pairs; code fences and headings stay verbatim."""
    blocks: list[tuple[bool, str]] = []
    paragraphs: list[str] = []
    lines: list[str] = []

    def end_paragraph() -> None:
        if "".join(lines).strip():
            paragraphs.append("\n".join(lines).strip())
        lines.clear()

    def flush_prose() -> None:
        end_paragraph()
        chunk = ""
        for para in paragraphs:
            if chunk and len(chunk) + len(para) + 2 > MAX_CHUNK_CHARS:
                blocks.append((True, chunk))
                chunk = ""
            chunk = f"{chunk}\n\n{para}" if chunk else para
        if chunk:
            blocks.append((True, chunk))
        paragraphs.clear()

    source = text.splitlines()
    i = 0
    while i < len(source):
        line = source[i]
        opener = FENCE.match(line)
        if opener:
            flush_prose()
            marker = opener.group(1)
            # A fence closes only on a line of the same character, at least as long.
            closer = re.compile(rf"^ {{0,3}}{re.escape(marker[0])}{{{len(marker)},}}\s*$")
            j = i + 1
            while j < len(source) and not closer.match(source[j]):
                j += 1
            blocks.append((False, "\n".join(source[i : j + 1])))
            i = j + 1
            continue
        if HEADING.match(line):
            flush_prose()
            blocks.append((False, line.strip()))
        elif line.strip():
            lines.append(line)
        else:
            end_paragraph()
        i += 1
    flush_prose()
    return blocks


def call_model(draft: str, url: str, key: str, n_predict: int) -> tuple[str, bool]:
    """Return the rewrite and whether it stopped at the n_predict limit."""
    body = {
        "prompt": build_prompt(draft),
        "temperature": 1.0,
        "top_p": 0.95,
        "top_k": 0,
        "min_p": 0,
        "repeat_penalty": 1.0,
        "n_predict": n_predict,
    }
    data = json.dumps(body).encode()
    headers = {"Content-Type": "application/json", "Authorization": f"Bearer {key}"}
    deadline = time.monotonic() + COLD_START_DEADLINE_S
    while True:
        req = urllib.request.Request(url, data, headers)
        try:
            with urllib.request.urlopen(req, timeout=330) as resp:
                result = json.load(resp)
                return result["content"].strip(), result.get("stop_type") == "limit"
        except urllib.error.HTTPError as err:
            if err.code in (401, 403):
                sys.exit(f"humanize: Runpod rejected the API key (HTTP {err.code})")
            problem = f"HTTP {err.code}"
        except (urllib.error.URLError, TimeoutError) as err:
            problem = str(err)
        if time.monotonic() > deadline:
            sys.exit(f"humanize: endpoint not ready after {COLD_START_DEADLINE_S}s ({problem})")
        print(f"humanize: waiting for a worker ({problem})", file=sys.stderr)
        time.sleep(10)


def fact_issues(draft: str, out: str) -> list[str]:
    issues = []
    for label, pattern in (("number", r"\d+(?:[.,]\d+)*"), ("url", r"https?://\S+")):
        before, after = Counter(re.findall(pattern, draft)), Counter(re.findall(pattern, out))
        issues += [f"missing {label} {x}" for x in sorted((before - after).elements())]
        issues += [f"added {label} {x}" for x in sorted((after - before).elements())]
    return issues


def rewrite_piece(draft: str, url: str, key: str, n_predict: int) -> tuple[str, list[str]]:
    out, truncated = call_model(draft, url, key, n_predict)
    issues = fact_issues(draft, out)
    if truncated:
        issues.insert(0, "rewrite cut off at the output limit")
    return out, issues


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("file", nargs="?", help="input file (default: stdin)")
    args = parser.parse_args()

    key = os.environ.get("RUNPOD_API_KEY")
    if not key:
        sys.exit("humanize: RUNPOD_API_KEY is not set")
    url = os.environ.get("HUMANIZER_URL")
    if not url:
        sys.exit("humanize: HUMANIZER_URL is not set")
    text = open(args.file, encoding="utf-8").read() if args.file else sys.stdin.read()
    if not text.strip():
        sys.exit("humanize: empty input")

    out_blocks = []
    flagged = False
    for rewrite, block in split_blocks(text):
        if not rewrite:
            out_blocks.append(block)
            continue
        out, issues = rewrite_piece(block, url, key, max(256, min(2048, int(len(block) / 4 * 2.5))))
        if issues:
            # The model slips on single facts now and then; one more sample usually
            # fixes it. A cut-off rewrite gets the full output budget.
            retry, retry_issues = rewrite_piece(block, url, key, 2048)
            if len(retry_issues) < len(issues):
                out, issues = retry, retry_issues
        if issues:
            flagged = True
            print(f"humanize: check this piece: {'; '.join(issues)}", file=sys.stderr)
        out_blocks.append(out)

    print("\n\n".join(out_blocks))
    sys.exit(2 if flagged else 0)


if __name__ == "__main__":
    main()
